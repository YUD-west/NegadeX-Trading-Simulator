# ─────────────────────────────────────────────────────────────────────────────
# NegadeX backend — environment configuration
#
# Copy this file to `.env` and adjust before running the server.
# ─────────────────────────────────────────────────────────────────────────────

# HTTP server
PORT=5000
NODE_ENV=development

# MongoDB.  Leave EMPTY to run in zero-dependency in-memory mode (great for demos
# and CI).  Set to a connection string in production for durable persistence.
MONGO_URI=

# Auth.  REPLACE the secret in production with at least 32 random characters
# (e.g. `openssl rand -hex 32`).  Token lifetime accepts any ms-style value.
JWT_SECRET=replace-this-with-a-strong-secret-min-32-chars
JWT_EXPIRES_IN=7d

# CORS allow-list.  Single origin OR comma-separated list of origins.  Wildcard
# patterns are supported per entry (e.g. https://*.vercel.app) so Vercel preview
# URLs work without redeploying.  Use `true` or `*` to allow all (NOT recommended
# in production).
#   Example (production):
#     CLIENT_ORIGIN=https://negadex.vercel.app,https://*.vercel.app
CLIENT_ORIGIN=http://localhost:5173

# Market simulator
SIM_TICK_MS=2500

# Virtual capital handed out on signup, in Birr.
STARTING_BALANCE=1000000

# Operator account created (or promoted) on every boot in both Mongo and
# in-memory modes.  CHANGE THESE BEFORE DEPLOYING — the defaults are public.
# Pick a strong password (12+ chars, mixed case, digits, symbols).
ADMIN_EMAIL=admin@market.io
ADMIN_PASSWORD=Admin@12345
ADMIN_NAME=Market Admin
